    {
      "parameters": {
        "jsCode": "// Gemini output is text that contains JSON\nconst rawText = $json.content.parts[0].text;\n\n// Remove markdown if Gemini wrapped the JSON\nconst cleaned = rawText.replace(/```json|```/g, '').trim();\n\n// Parse JSON string to real object\nconst parsed = JSON.parse(cleaned);\n\n// Return clean structured data\nreturn [\n  {\n    json: parsed\n  }\n];"
      },
