    {
      "parameters": {
        "functionCode": "// Get skills from Gemini output\nconst skills = $node[\"Parse Gemini Output\"].json.skills\n  .map(skill => skill.toLowerCase());\n\n// Score all jobs by match percentage\nconst scoredJobs = items\n  .filter(item => item.json.description)\n  .map(item => {\n    const description = item.json.description.toLowerCase();\n\n    const matchedSkills = skills.filter(skill =>\n      description.includes(skill)\n    );\n\n    const matchPercentage = skills.length === 0\n      ? 0\n      : Math.round((matchedSkills.length / skills.length) * 100);\n\n    return {\n      json: {\n        ...item.json,\n        matchPercentage,\n        matchedSkills\n      }\n    };\n  });\n\n// Sort all jobs by highest match percentage\nscoredJobs.sort(\n  (a, b) => b.json.matchPercentage - a.json.matchPercentage\n);\n\n// Always return top 5 closest jobs\nreturn scoredJobs.slice(0, 1);\n"
      },
